<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Seedance Studio</title>
<style>
  :root{--bg:#eceef3;--ink:#141a2e;--mute:#5d6580;--card:#fff;--line:#d5d9e4;--acc:#3a3fff;--err:#c8283d}
  @media(prefers-color-scheme:dark){:root{--bg:#0f1222;--ink:#eef0fa;--mute:#98a0bd;--card:#181c33;--line:#2a3050;--acc:#7b80ff}}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    padding:max(16px,env(safe-area-inset-top)) 16px max(24px,env(safe-area-inset-bottom))}
  main{max-width:560px;margin:0 auto}
  h1{font-size:28px;letter-spacing:-.02em;margin:8px 0 2px}
  .sub{color:var(--mute);margin:0 0 18px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:14px}
  label{display:block;font-size:13px;font-weight:600;color:var(--mute);margin:0 0 6px}
  textarea,input,select{width:100%;font:inherit;color:var(--ink);background:transparent;border:1px solid var(--line);border-radius:10px;padding:11px}
  textarea{min-height:130px;resize:vertical}
  .row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
  button{font:inherit;font-weight:700;border:0;border-radius:10px;padding:14px;width:100%;background:var(--acc);color:#fff;margin-top:14px}
  button:disabled{opacity:.55}
  button.ghost{background:transparent;color:var(--ink);border:1px solid var(--line);margin-top:8px;padding:11px}
  #msg{margin:12px 0 0;font-size:14px;color:var(--mute)}
  #msg.err{color:var(--err)}
  video{width:100%;border-radius:10px;background:#000;display:block}
  a.dl{display:block;text-align:center;margin-top:10px;color:var(--acc);font-weight:700}
  .hist{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  .hist video{aspect-ratio:9/16;object-fit:cover}
  .hist p{grid-column:1/-1;margin:0;color:var(--mute);font-size:14px}
</style>
</head>
<body>
<main>
  <h1>Seedance Studio</h1>
  <p class="sub">Prompt in, video out.</p>

  <div class="card">
    <label for="pw">Password</label>
    <input id="pw" type="password" autocomplete="current-password" placeholder="your APP_PASSWORD">
  </div>

  <div class="card">
    <label for="prompt">Prompt</label>
    <textarea id="prompt" placeholder="Handheld shot, woman walks through a rainy Nairobi street at golden hour, neon reflections, shallow depth of field, slow push-in"></textarea>
    <div class="row">
      <div><label for="ar">Ratio</label>
        <select id="ar"><option>9:16</option><option>16:9</option><option>1:1</option></select></div>
      <div><label for="dur">Seconds</label>
        <select id="dur"><option>5</option><option>10</option></select></div>
      <div><label for="res">Quality</label>
        <select id="res"><option>720p</option><option>480p</option></select></div>
    </div>
    <button id="go">Generate video</button>
    <p id="msg"></p>
  </div>

  <div class="card" id="out" hidden>
    <video id="player" controls playsinline loop></video>
    <a id="dl" class="dl" target="_blank" rel="noopener" download>Download video</a>
  </div>

  <div class="card">
    <label>Recent (this device)</label>
    <div class="hist" id="hist"><p>Nothing yet.</p></div>
    <button class="ghost" id="clear">Clear history</button>
  </div>
</main>

<script>
const $ = (id) => document.getElementById(id);
const msg = (t, err) => { $("msg").textContent = t; $("msg").className = err ? "err" : ""; };
const store = {
  get(k, d) { try { return JSON.parse(localStorage.getItem(k)) ?? d; } catch { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
};

$("pw").value = store.get("pw", "");

async function api(path, body) {
  const r = await fetch(path, {
    method: "POST",
    headers: { "Content-Type": "application/json", "x-app-password": $("pw").value },
    body: JSON.stringify(body),
  });
  const d = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(d.error || "Request failed");
  return d;
}

function showVideo(url) {
  $("out").hidden = false;
  $("player").src = url;
  $("dl").href = url;
  $("player").play().catch(() => {});
}

function renderHist() {
  const h = store.get("hist", []);
  $("hist").innerHTML = h.length ? "" : "<p>Nothing yet.</p>";
  h.forEach((url) => {
    const v = document.createElement("video");
    v.src = url; v.muted = true; v.playsInline = true; v.preload = "metadata";
    v.onclick = () => { showVideo(url); window.scrollTo({ top: 0, behavior: "smooth" }); };
    $("hist").appendChild(v);
  });
}

$("clear").onclick = () => { store.set("hist", []); renderHist(); };

$("go").onclick = async () => {
  const prompt = $("prompt").value.trim();
  if (!prompt) return msg("Write a prompt first.", true);
  store.set("pw", $("pw").value);
  $("go").disabled = true;
  msg("Sending job…");
  try {
    const job = await api("/api/generate", {
      prompt, aspect_ratio: $("ar").value, duration: $("dur").value, resolution: $("res").value,
    });
    const started = Date.now();
    while (true) {
      await new Promise((r) => setTimeout(r, 4000));
      const s = await api("/api/status", job);
      if (s.status === "COMPLETED") {
        showVideo(s.video);
        store.set("hist", [s.video, ...store.get("hist", [])].slice(0, 12));
        renderHist();
        msg("Done. Fal links expire eventually, so download what you want to keep.");
        break;
      }
      if (s.status === "FAILED") throw new Error(s.error || "Generation failed");
      const secs = Math.round((Date.now() - started) / 1000);
      msg(`${s.status === "IN_QUEUE" ? "In queue" : "Generating"}… ${secs}s`);
      if (secs > 600) throw new Error("Timed out after 10 min");
    }
  } catch (e) {
    msg(e.message, true);
  } finally {
    $("go").disabled = false;
  }
};

renderHist();
</script>
</body>
</html>
